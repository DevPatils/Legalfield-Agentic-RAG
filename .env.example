# Copy to .env and fill in. Never commit .env.

# --- Embeddings: pick ONE provider ---
# voyage  -> voyage-law-2 (legal-domain model, preferred per Architecture.md §4)
# openai  -> text-embedding-3-large
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Reranker: pick ONE ---
# cohere -> Cohere Rerank API
# local  -> bge-reranker-large via sentence-transformers (no key, needs torch)
RERANK_PROVIDER=cohere
COHERE_API_KEY=

# --- LLM for all agent reasoning (planner / sufficiency / generate / faithfulness) ---
# anthropic -> claude-sonnet-5 (+ claude-haiku-4-5 for the planner)
# openai    -> gpt-4o-mini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Cheaper model for the planner node only. Set equal to LLM_MODEL to disable the split.
LLM_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Infrastructure (defaults match docker-compose.yml) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_chunks
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agentic_rag_legal

# --- Agent tuning (Architecture.md §7) ---
MAX_REFINE_ITERATIONS=3
RETRIEVE_TOP_N=40
RERANK_TOP_K=6
RRF_K=60
